PORT=3000
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233
XRPL_HISTORY_LIMIT=100
# Speculos HTTP API reachable from the machine running the backend.
# For a remote emulator, use its private Tailscale IP/DNS name and published host port.
SPECULOS_ADDRESS=127.0.0.1
SPECULOS_API_PORT=5000
# Optional comma-separated exact browser origins for deployed frontend access.
CORS_ALLOWED_ORIGINS=
VITE_API_BASE_URL=
SYSTEM_ONE_API_KEY=
SYSTEM_ONE_BASE_URL=https://system-one.dev/v1
SYSTEM_ONE_MODEL=jev
# QR review budget: the spending limit is policy; "spent" is measured from XRPL history.
# Optional. When set it overrides a `limit` sent in the QR link.
QR_BUDGET_LIMIT_XRP=
QR_BUDGET_WINDOW_HOURS=24
